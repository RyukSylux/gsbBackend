{
    "source": {
        "include": ["./index.js", "./controller", "./models", "./routes", "./utils", "./middleware"],
        "includePattern": ".+\\.js$",
        "exclude": ["node_modules", "docs"]
    },
    "plugins": ["plugins/markdown"],
    "opts": {
        "encoding": "utf8",
        "destination": "./docs/",
        "recurse": true,
        "verbose": true,
        "readme": "./readme.md",
        "template": "node_modules/clean-jsdoc-theme"
    },
    "templates": {
        "cleverLinks": true,
        "monospaceLinks": false,
        "default": {
            "outputSourceFiles": true
        },
        "clean-jsdoc-theme": {
            "name": "GSB Backend API",
            "title": "GSB Backend Documentation",
            "theme": "dark",
            "menu": {
                "Github": {
                    "href": "https://github.com/RyukSylux/gsbBackend",
                    "target": "_blank",
                    "class": "menu-item",
                    "id": "github_link"
                }
            },
            "meta": {
                "title": "GSB Backend API Documentation",
                "description": "Documentation de l'API backend GSB",
                "keyword": "docs, api, backend, gsb"
            },
            "codepen": true,
            "search": true,
            "collapse": true,
            "create_style": "table { width: 100%; table-layout: auto; display: table !important; overflow-x: auto; } .params-container, .props-container { overflow-x: auto; width: 100%; } td.name, td.type { white-space: nowrap; width: 1%; } .details .props { margin-left: 10px; border-left: 2px solid #444; padding-left: 10px; } .details table.props { display: table !important; }"
        }
    },
    "tags": {
        "allowUnknownTags": true
    }
}
